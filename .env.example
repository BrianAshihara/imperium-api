# API
PORT=3333
NODE_ENV=development

# SQLite file, relative to the project root
DATABASE_URL="file:./dev.db"

# Required in production, falls back to an insecure value in development
JWT_SECRET="change-me"

# Origin allowed by CORS (the Next.js dev server)
CORS_ORIGIN="http://localhost:3000"

# Credentials created by `npm run seed`
SEED_USER_EMAIL="demo@imperium.local"
SEED_USER_PASSWORD="demo12345"
